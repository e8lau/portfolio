---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

interface LocalItem {
    title: string;
    company?: string;
    dates?: string;
    category?: string;
    summary?: string;
    bullets: string[];
    order?: number;
}

const {
    category,
    limit,
    items,
    variant = "page",
    maxChars = 200,
    maxTitleLen = 100,
} = Astro.props as {
    category?: string | string[];
    limit?: number;
    items?: LocalItem[];
    variant?: "page" | "home";
    maxChars?: number;
    maxTitleLen?: number;
};

function normalizeCategory(val?: string) {
    return (val || "").trim().toLowerCase();
}
function stripTags(html?: string) {
    if (!html) return "";
    return html.replace(/<[^>]*>/g, "");
}
function truncatePlain(text: string, max: number) {
    if (!text) return "";
    if (text.length <= max) return text;
    return text.slice(0, max).replace(/\s+$/, "") + "...";
}

let entries: Array<
    Pick<
        LocalItem,
        | "title"
        | "company"
        | "dates"
        | "category"
        | "summary"
        | "bullets"
        | "order"
    >
> = [];

if (items && Array.isArray(items)) {
    entries = items;
} else {
    const all = await getCollection("experience", (e) => !e.data.draft);
    entries = all.map((e: CollectionEntry<"experience">) => ({
        title: e.data.title,
        company: e.data.company,
        dates: e.data.dates,
        category: e.data.category,
        summary: e.data.summary,
        bullets: e.data.bullets,
        order: e.data.order,
    }));
}

if (category) {
    const cats = Array.isArray(category) ? category : [category];
    const wanted = new Set(cats.map((c) => normalizeCategory(c)));
    entries = entries.filter((e) => wanted.has(normalizeCategory(e.category)));
}

entries.sort((a, b) => {
    const ao = a.order ?? 9999;
    const bo = b.order ?? 9999;
    if (ao !== bo) return ao - bo;
    return a.title.localeCompare(b.title);
});

if (typeof limit === "number" && limit > 0) {
    entries = entries.slice(0, limit);
}

const headerClass =
    variant === "home"
        ? "grid-list-items__title list-items__item-header"
        : "list-items__item-header";

const textClass =
    variant === "home"
        ? "grid-list-items__text list-items__item-text"
        : "list-items__item-text";
---

<div class="grid-full grid-list-items list-items show-ctr">
    {
        entries.map((e) => {
            const summaryPlain = stripTags(e.summary);
            const displaySummary =
                variant === "home"
                    ? truncatePlain(summaryPlain, maxChars)
                    : summaryPlain;

            return (
                <div class="grid-list-items__item list-items__item">
                    <div class={headerClass}>
                        <h3 class="list-items__item-title">{truncatePlain(e.title, maxTitleLen)}</h3>
                    </div>

                    <div class={textClass}>
                        {/* Page variant only: Company + Dates */}
                        {variant === "page" && (e.company || e.dates) && (
                            <p class="list-items__meta">
                                {e.company && <strong>{e.company}</strong>}
                                {e.company && e.dates && " | "}
                                {e.dates}
                            </p>
                        )}

                        {variant === "page" ? (
                            e.summary && <p set:html={e.summary} />
                        ) : (
                            <p>{displaySummary}</p>
                        )}

                        {variant === "page" && e.bullets?.length && (
                            <ul class="list-experience">
                                {e.bullets.map((b) => (
                                    <li>{b}</li>
                                ))}
                            </ul>
                        )}
                    </div>
                </div>
            );
        })
    }
</div>
