---
import IconSocials from "./IconSocials.astro";
const BASE = import.meta.env.BASE_URL || "/";

// You can tweak these items without touching the HTML.
const aboutHtml = `
  <h3>About Ethan</h3>
  <p>
    Data-driven product & strategy. Portfolio of projects across analytics, venture, and design.
  </p>
`;

// Keep this in sync with site.webmanifest "shortcuts" (below).
const footerLinks: { label: string; href: string }[] = [
    { label: "Home", href: `${BASE}` },
    { label: "Experience", href: `${BASE}experience` },
    { label: "Projects", href: `${BASE}projects` },
    { label: "About", href: `${BASE}about` },
    { label: "Contact", href: `${BASE}contact` },
];
---

<footer class="s-footer">
    <div class="row s-footer__content">
        <div class="column xl-6 lg-6 md-12 s-footer__block s-footer__about">
            <div id="footer-content-placeholder" set:html={aboutHtml} />
        </div>

        <div
            class="column xl-3 lg-6 md-12 s-footer__block s-footer__site-links"
        >
            <h3>Site Links</h3>
            <ul id="footer-links" class="link-list">
                {
                    footerLinks.map((l) => (
                        <li>
                            <a href={l.href}>{l.label}</a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div
            class="column xl-3 lg-6 md-12 s-footer__block s-footer__site-links"
        >
            <h3>Skills</h3>
            <ul class="s-footer__list">
                <li>
                    <a>Technical:</a> Python, SQL, Machine Learning, Excel, R, Java,
                    JavaScript, Web Development
                </li>
                <li>
                    <a>Core:</a> Data Analytics, Financial Modeling, Market Research,
                    Public Speaking, Project Management
                </li>
            </ul>
        </div>
    </div>

    <div class="row s-footer__bottom">
        <div class="column xl-6 lg-12">
            <ul class="s-footer__social social-list">
                <IconSocials />
            </ul>
        </div>
        <div class="column xl-6 lg-12">
            <p class="ss-copyright">
                <span>© Copyright Ethan Lau {new Date().getFullYear()}</span>
                <span
                    >Design by <a href="https://www.styleshout.com/"
                        >StyleShout</a
                    > Distribution By <a href="https://themewagon.com"
                        >ThemeWagon</a
                    ></span
                >
            </p>
        </div>

        <div class="ss-go-top">
            <a class="smoothscroll" title="Back to Top" href="#top">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    width="36"
                    height="36"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><polyline points="17 11 12 6 7 11"></polyline><line
                        x1="12"
                        y1="18"
                        x2="12"
                        y2="6"></line></svg
                >
            </a>
        </div>
    </div>
</footer>
