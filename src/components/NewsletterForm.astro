<form id="mc-form" class="mc-form subscribe-form">
    <input
        type="email"
        name="EMAIL"
        class="u-fullwidth text-center"
        placeholder="Your Email Address"
        required
    />
    <input
        type="submit"
        name="subscribe"
        value="Subscribe"
        class="btn btn--primary btn--small u-fullwidth"
    />
    <div class="mc-status" aria-live="polite"></div>
</form>
