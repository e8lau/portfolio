---
import IconSocials from "../common/IconSocials.astro";
const BASE = import.meta.env.BASE_URL || "/";
---

<!-- About teaser -->
<section id="about" class="s-about target-section">
    <div class="row s-about__content width-sixteen-col">
        <div class="column grid-block grid-section-split">
            <img
                src={`${BASE}images/geometric_shape.svg`}
                alt=""
                class="s-about__content-imgbg"
            />

            <div class="section-header grid-section-split__header">
                <div class="text-pretitle">About</div>
                <h2 class="text-display-title">
                    Learning through experience. Growing through data.
                </h2>
            </div>
            <!-- end section-header -->

            <div class="s-about__content-main grid-section-split__primary">
                <p class="attention-getter">
                    I am an economics-driven, data-science-oriented strategist
                    focused on leveraging analytical precision and technology to
                    drive smarter business, investment, and product decisions.
                    My goal is to operate at the intersection of strategy, data,
                    and innovation—translating complex information into
                    frameworks that advance growth, efficiency, and impact.
                </p>

                <p class="attention-getter">
                    I hold a B.S. in Management Science with a Data Science
                    minor from UC San Diego, where I specialized in
                    optimization, game theory, and computational modeling. My
                    experience spans venture capital, strategy consulting, data
                    analytics, and early-stage startup development—integrating
                    quantitative insight with business execution to shape
                    investment theses, build predictive models, and scale
                    emerging-technology initiatives.
                </p>

                <p class="attention-getter">
                    Across every role, I strive to connect analytical rigor with
                    strategic clarity—whether structuring investment strategies,
                    developing machine-learning systems, or designing frameworks
                    that transform data-backed insights into real-world results.
                    I’m driven by curiosity, precision, and the pursuit of
                    translating information into meaningful outcomes.
                </p>
            </div>
            <!-- end s-about__content-main -->

            <div class="s-about__content-btn grid-section-split__bottom">
                <a href={`${BASE}about`} class="btn btn--stroke u-fullwidth"
                    >More About Me</a
                >

                <ul class="s-about__social social-list">
                    <IconSocials />
                </ul>
                <!-- end s-footer__social -->
            </div>
            <!-- end s-about__content-btn -->
        </div>
        <!-- content-inner -->
    </div>
</section>
<!-- end s-about -->
