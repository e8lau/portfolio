---
// src/components/home/HomeExpertise.astro
import ExperienceList from "../experience/ExperienceList.astro";
const BASE = import.meta.env.BASE_URL || "/";
---

<!-- expertise -->
<section id="expertise" class="s-expertise">
    <div class="row s-expertise__content width-sixteen-col">
        <div class="column xl-12 grid-block grid-section-split">
            <div class="section-header grid-section-split__header">
                <div class="text-pretitle">Expertise</div>
                <h2 class="text-display-title">
                    My job & organization experiences.
                </h2>
                <p class="lead">
                    My path hasn’t been linear—but it’s been intentional. Though
                    diverse in scope, each role has strengthened my ability to
                    connect analytical rigor with business insight and deliver
                    meaningful results.
                </p>
            </div><!-- end section-header -->

            <div class="s-expertise__content-main grid-section-split__primary">
                <!-- Show first four, homepage variant, truncate to 200 chars -->
                <ExperienceList variant="home" limit={4} maxChars={1000} />
            </div><!-- end s-expertise__content-main -->

            <div class="s-expertise__content-btn grid-section-split__bottom">
                <a
                    href={`${BASE}experience`}
                    class="btn btn--stroke u-fullwidth">View All Experience</a
                >
            </div><!-- end s-expertise__content-btn -->
        </div><!-- end grid-block-->
    </div><!-- end s-expertise__content -->
</section><!-- end s-expertise -->
