---
import ProjectList from "../projects/ProjectList.astro";
const BASE = import.meta.env.BASE_URL || "/";
---

<!-- projects -->
<section id="projects" class="s-clients">
    <div class="row s-projects__content width-sixteen-col">
        <div class="column xl-12 grid-block">
            <div class="grid-full section-header text-center">
                <div class="text-pretitle">Recent Projects, Awards, & More</div>
                <h2 class="text-display-title">
                    Latest Projects Additions
                </h2>
            </div><!-- end section-header -->

            <div class="grid-full s-projects__content-main grid-list-items">
                <ProjectList limit={4} categoryHrefBase={`${BASE}projects`} />
            </div><!-- end grid-list-items -->
        </div><!-- end grid-block -->

        <!-- <div class="grid-full section-header text-center">
            <a href={`${BASE}experience`} class="btn btn--primary"
                >See All Experiences</a
            >
        </div> -->
    </div><!-- end s-projects__content -->
</section><!-- end s-projects -->
