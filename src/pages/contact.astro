---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout title="Contact" current="contact">
    <section id="content" class="s-content">
        <!-- Page header -->
        <PageHeader pretitle="Contact" title="Get In Touch" />

        <!-- Intro row -->
        <section class="s-pagecontent pagecontent">
            <div class="row pageintro">
                <div class="column xl-6 lg-12">
                    <!-- Paste the h2 display title -->
                    <!-- "Let's take your business to the next level." -->
                </div>
                <div class="column xl-6 lg-12 u-flexitem-x-right">
                    <!-- Paste the lead paragraph -->
                </div>
            </div>

            <!-- Media banner -->
            <div class="row pagemedia">
                <div class="column xl-12">
                    <figure class="page-media">
                        <!-- Replace src/srcset with /images/... paths in /public -->
                        <!-- <img src="/images/thumbs/contact/contact-1200.jpg" ... /> -->
                    </figure>
                </div>
            </div>

            <!-- Main content -->
            <div class="row width-narrower pagemain">
                <div class="column xl-12">
                    <h2>Let's Work Together</h2>

                    <div class="row">
                        <!-- Left CTA column -->
                        <div class="column xl-6 md-12 contact-cta">
                            <!-- Paste CTA paragraph(s) -->
                            <!-- Email button (update your email) -->
                            <!--
              <a href="mailto:you@yourdomain.com"
                 class="btn btn--primary u-fullwidth contact-btn">
                Send Me An Email
              </a>
              -->
                        </div>

                        <!-- Right info column -->
                        <div class="column xl-5 md-12 u-flexitem-x-right">
                            <div class="contact-block">
                                <h6>Follow On Social</h6>
                                <!-- Paste/adjust social list URLs -->
                                <!-- <ul class="contact-social social-list">...</ul> -->
                            </div>

                            <div class="contact-block">
                                <h6>Email</h6>
                                <!-- <a href="mailto:you@yourdomain.com">you@yourdomain.com</a> -->
                            </div>

                            <div class="contact-block">
                                <h6>Phone</h6>
                                <!-- <ul class="contact-list">
                      <li><a href="tel:+1-xxx-xxx-xxxx">+1 xxx xxx xxxx</a></li>
                     </ul> -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Testimonials (keep vendor Swiper for now or swap to React island later) -->
        <section class="s-testimonials">
            <div class="s-testimonials__header row row-x-center text-center">
                <div class="column xl-8 lg-12">
                    <p class="text-pretitle">Testimonials</p>
                    <h3>Reviews From Real Clients</h3>
                </div>
            </div>

            <div class="row s-testimonials__content">
                <div class="column xl-12 testimonials">
                    <!-- OPTION A: paste the existing Swiper markup and keep /js/plugins.js -->
                    <!--
          <div class="swiper-container testimonials__slider page-slider">
            <div class="swiper-wrapper">
              ...slides...
            </div>
            <div class="swiper-pagination"></div>
          </div>
          -->
                    <!-- OPTION B: replace with a React island later -->
                </div>
            </div>
        </section>
    </section>
</BaseLayout>
