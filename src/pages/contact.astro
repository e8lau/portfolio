---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import IconSocials from "../components/common/IconSocials.astro";

const EMAIL = "mindscast.ethan+portfolio@gmail.com";
const SUBJECT = "Let's Connect!";
const BODY = `Hi Ethan,

I came across your portfolio and wanted to reach out about ...`;

const enc = encodeURIComponent;
const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${enc(EMAIL)}&su=${enc(SUBJECT)}&body=${enc(BODY)}`;
---

<BaseLayout title="Contact" current="contact">
    <section id="content" class="s-content">
        <!-- Page header -->
        <PageHeader pretitle="Contact" title="Get In Touch" />

        <section class="s-pagecontent pagecontent">
            <div class="row pageintro">
                <div class="column xl-6 lg-12">
                    <h2 class="text-display-title">
                        Let's Build Something Meaningful.
                    </h2>
                </div>
                <div class="column xl-6 lg-12 u-flexitem-x-right">
                    <p class="lead">
                        I’m drawn to ideas that challenge expectations, drive
                        real change, and create lasting impact. Whether you’re
                        looking for someone to tackle a big project, bring fresh
                        perspective to a team, or simply exchange ideas, I’m
                        ready to connect. Every opportunity starts with a
                        conversation — let’s see where ours could lead.
                    </p>
                </div>
            </div>
            <!-- pageintro -->

            <!-- <div class="row pagemedia">
                <d class="column xl-12">
                    <figure class="page-media">
                        <img
                            src="images/thumbs/contact/contact-1200.jpg"
                            srcset="images/thumbs/contact/contact-2400.jpg 2400w, 
                                             images/thumbs/contact/contact-1200.jpg 1200w, 
                                             images/thumbs/contact/contact-600.jpg 600w"
                            sizes="(max-width: 2400px) 100vw, 2400px"
                            alt=""
                        />
                    </figure>
                </d>
            </div> -->
            <!-- pagemedia -->

            <div class="row width-narrower pagemain">
                <div class="column xl-12">
                    <h2>Let's Connect!</h2>

                    <div class="row">
                        <div class="column xl-6 md-12 contact-cta">
                            <p>
                                Big projects, ambitious ideas, early-stage
                                thoughts — all of it starts with a simple hello.
                                If you’re exploring new possibilities, building
                                something meaningful, or just want to connect,
                                I’d love to hear from you. Reach out anytime —
                                I’m excited to see what’s next.
                            </p>

                            <a
                                href={gmailHref}
                                class="btn btn--primary u-fullwidth contact-btn"
                                id="gmail-btn"
                                data-email={EMAIL}
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M20 4H4c-1.103 0-2 .897-2 2v12c0 1.103.897 2 2 2h16
                                        c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2zm0 2v.511l-8
                                        6.223-8-6.222V6h16zM4 18V9.044l7.386 5.745a.994.994
                                        0 0 0 1.228 0L20 9.044 20.002 18H4z"
                                    ></path>
                                </svg>
                                Send Me An Email
                            </a>

                            <div class="text-body-sm" style="margin-top:.6rem;">
                                Having trouble? ·
                                <button
                                    type="button"
                                    class="btn btn--stroke btn--small"
                                    id="copy-email"
                                    data-email={EMAIL}
                                    style="margin-left:.4rem;"
                                >
                                    Copy email
                                </button>
                                <span
                                    id="copy-toast"
                                    class="u-hidden"
                                    aria-live="polite"
                                    style="margin-left:.6rem;">Copied ✓</span
                                >
                            </div>

                            <script type="module">
                                // Robust copy: read from data-email, not DOM text
                                const copyBtn =
                                    document.getElementById("copy-email");
                                const toast =
                                    document.getElementById("copy-toast");

                                copyBtn?.addEventListener("click", async () => {
                                    const email =
                                        copyBtn.dataset.email ||
                                        "mindscast.ethan@gmail.com";
                                    try {
                                        await navigator.clipboard.writeText(
                                            email,
                                        );
                                        toast?.classList.remove("u-hidden");
                                        setTimeout(
                                            () =>
                                                toast?.classList.add(
                                                    "u-hidden",
                                                ),
                                            1600,
                                        );
                                    } catch {
                                        // Fallback prompt if clipboard blocked
                                        window.prompt(
                                            "Copy email address:",
                                            email,
                                        );
                                    }
                                });
                            </script>
                        </div>
                        <div class="column xl-5 md-12 u-flexitem-x-right">
                            <div class="contact-block">
                                <h6>Follow On Social</h6>
                                <ul class="contact-social social-list">
                                    <IconSocials />
                                </ul>
                                <!-- end s-footer__social -->
                            </div>

                            <div class="contact-block">
                                <h6>Email</h6>
                                <a href="mailto:mindscast.ethan@gmail.com"
                                    >mindscast.ethan@gmail.com</a
                                >
                            </div>

                            <div class="contact-block">
                                <h6>Phone</h6>
                                <ul class="contact-list">
                                    <li>
                                        <a href="tel:197-543-2345"
                                            >+1 (650) 542-0682</a
                                        >
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end pagemain -->
        </section>
        <!-- pagecontent -->
    </section>
</BaseLayout>
