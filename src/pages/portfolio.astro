---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import CTA from "../components/common/CTA.astro";

// NEW: hydrate search/filter UI as a React island
import ProjectsBrowser from "../components/projects/ProjectsBrowser.tsx";
import { getCollection } from "astro:content";

const BASE = import.meta.env.BASE_URL || "/";

// Load projects on the server for stable initial order
const all = await getCollection("projects", (e) => !e.data.draft);
const entries = all
    .map((e) => ({ slug: e.slug, ...e.data }))
    .sort((a, b) => {
        const ao = a.order ?? 9999;
        const bo = b.order ?? 9999;
        if (ao !== bo) return ao - bo;
        return a.title.localeCompare(b.title);
    });
---

<BaseLayout title="Projects" current="projects">
    <section id="content" class="s-content">
        <!-- Update copy from Blog → Projects (pure content change) -->
        <PageHeader pretitle="Ideas in Action" title="My Projects, Awards, & More" />

        <section class="s-pagecontent pagecontent">
            <div class="row">
                <div class="column xl-12 grid-block">
                    <!-- Search + Filter + Cards (uses existing CSS classes) -->
                    <ProjectsBrowser
                        client:load
                        entries={entries}
                        categoryHrefBase={`${BASE}projects`}
                        maxChars={120}
                        maxTitleLen={40}
                    />
                </div>
            </div>
            <!-- end row -->

            <!-- keep your existing pagination for later wiring -->
            <div class="row navigation pagination">
                <div class="column xl-12">
                    <nav class="pgn">
                        <ul>
                            <li>
                                <a class="pgn__prev" href="#0">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        ><path
                                            d="M12.707 17.293L8.414 13H18v-2H8.414l4.293-4.293-1.414-1.414L4.586 12l6.707 6.707z"
                                        ></path></svg
                                    >
                                </a>
                            </li>
                            <li><a class="pgn__num" href="#0">1</a></li>
                            <li><span class="pgn__num current">2</span></li>
                            <li><a class="pgn__num" href="#0">3</a></li>
                            <li><a class="pgn__num" href="#0">4</a></li>
                            <li><a class="pgn__num" href="#0">5</a></li>
                            <li><span class="pgn__num dots">…</span></li>
                            <li><a class="pgn__num" href="#0">8</a></li>
                            <li>
                                <a class="pgn__next" href="#0">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        ><path
                                            d="M11.293 17.293l1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
                                        ></path></svg
                                    >
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <!-- end column -->
            </div>
            <!-- end pagination -->
        </section>

        <section id="cta" class="s-cta">
            <CTA BASE={BASE} />
        </section>
    </section>
</BaseLayout>
