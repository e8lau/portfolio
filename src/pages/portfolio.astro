---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import CTA from "../components/common/CTA.astro";

// NEW: hydrate search/filter UI as a React island
import { getCollection } from "astro:content";
import ProjectsBrowser from "../components/projects/ProjectsBrowser.tsx";
import { toCardProps } from "../lib/project-mappers";

const entries = await getCollection("projects");
const items = entries
    .filter((e) => !e.data.draft) // hide drafts
    .map(toCardProps);

const BASE = import.meta.env.BASE_URL || "/";
---

<BaseLayout title="Projects" current="projects">
    <section id="content" class="s-content">
        <!-- Update copy from Blog → Projects (pure content change) -->
        <PageHeader
            pretitle="Ideas in Action"
            title="My Projects, Awards, & More"
        />

        <section class="s-pagecontent pagecontent">
            <div class="row">
                <ProjectsBrowser client:load items={items} />
            </div>
