---
// src/pages/experience.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import ExperienceList from "../components/experience/ExperienceList.astro";
import CTA from "../components/common/CTA.astro";
const BASE = import.meta.env.BASE_URL || "/";
---

<BaseLayout title="Experience" current="experience">
    <section id="content" class="s-content">
        <PageHeader pretitle="Experience" title="High-Impact Experience" />

        <section class="s-pagecontent pagecontent">
            <div class="row pageintro">
                <div class="column xl-6 lg-12">
                    <h2 class="text-display-title">
                        My Education & Experience
                    </h2>
                </div>
                <div class="column xl-6 lg-12 u-flexitem-x-right">
                    <p class="lead">
                        I hold a B.S. in Management Science with a Data Science
                        minor from the University of California, San Diego,
                        where I specialized in optimization, game theory, and
                        computational modeling.
                    </p>
                </div>
            </div>
            <!-- pageintro -->

            <div class="row">
                <div class="column xl-12 grid-block">
                    <!-- All Experiences -->
                    <ExperienceList />

                    <!-- Example: Only Professional -->
                    <!-- <ExperienceList category="Professional" /> -->

                    <!-- Example: Multiple categories & limit -->
                    <!-- <ExperienceList category={["Professional","Leadership"]} limit={6} /> -->
                </div>
                <!-- end grid-block-->
            </div>
            <!-- end row -->
        </section>
        <!-- pagecontent -->

        <section id="cta" class="s-cta">
            <CTA BASE={BASE} />
        </section>
    </section>
</BaseLayout>
